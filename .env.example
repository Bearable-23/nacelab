# Copia este archivo a .env y pon tus valores reales.
# .env está en .gitignore y NUNCA debe commitearse.

# --- Tokens de las APIs de datos ---

# Banco de Indicadores del INEGI
# Gratis en: https://www.inegi.org.mx/servicios/api_indicadores.html
INEGI_TOKEN=

# SIE de Banxico (64 caracteres alfanuméricos)
# Gratis en: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# --- Google Cloud ---

GCP_PROJECT=nacelab-prod

# Service account a suplantar desde tu máquina. NO se define en Cloud Run:
# allá la cuenta va adjunta al servicio y se toma sola.
#
# Suplantar en local es lo que hace que corras con los permisos reales de la
# cuenta y no con los tuyos de Owner. Sin esto, un error de permisos no
# aparece hasta el despliegue.
#
#   sa-ingest     escribe en bronze
#   sa-transform  lee bronze, escribe silver y gold
#   sa-app        SOLO lee gold
IMPERSONATE_SA=sa-ingest@nacelab-prod.iam.gserviceaccount.com
