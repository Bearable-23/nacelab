# Copia este archivo a .env y pon tus tokens reales.
# .env está en .gitignore y NUNCA debe commitearse.

# Token del Banco de Indicadores del INEGI
# Se obtiene gratis en: https://www.inegi.org.mx/servicios/api_indicadores.html
INEGI_TOKEN=

# Token del SIE de Banxico (64 caracteres alfanuméricos)
# Se obtiene gratis en: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=
